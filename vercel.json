{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/online-katalog", "destination": "/e-catalog", "permanent": true },
    { "source": "/hakkimizda", "destination": "/about", "permanent": true },
    { "source": "/iletisim", "destination": "/contact", "permanent": true },
    { "source": "/referanslar", "destination": "/references", "permanent": true },
    { "source": "/foto-galeri", "destination": "/gallery", "permanent": true }
  ]
}
